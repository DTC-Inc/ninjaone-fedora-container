[Unit]
Description=NinjaOne Agent (systemd-init container)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/dtc-inc/ninjaone-fedora-container:latest

# container name AND hostname are both the host's real hostname (%H), so the
# agent reports the box -- not "ninjarmm-agent" -- to NinjaOne.
ContainerName=%H
HostName=%H
Network=host

# --systemd=always: podman boots the image's systemd as PID 1 and sets up the
# cgroup + tmpfs /run, /tmp it needs. Privileged for SMART, ZFS handoff, backups.
PodmanArgs=--systemd=always --privileged
Environment=container=podman

# NINJA_AGENT_URL (token-bearing) lives in this 0600 file, written by
# scripts/install.sh; the bootstrap unit installs the agent on first boot if the
# ninjarmm-agent volume is empty. Quadlet maps this to podman `--env-file`, which
# (a) does NOT honor systemd's `-` optional prefix -- a leading `-` gets treated
# as a literal relative path and resolved against /etc/containers/systemd/ -- and
# (b) requires the file to exist. So: no `-`, and install.sh always creates the
# file (empty if there's no URL yet).
EnvironmentFile=/etc/ninjarmm-agent.env

# Agent install + state persist in the volume at the canonical path.
Volume=ninjarmm-agent:/opt/NinjaRMMAgent

# Hardware visibility (SMART/sensors/inventory).
Volume=/dev:/dev

# FULL host access, established only while the container runs -- nothing is written
# to the host to set this up, and it's gone on uninstall. Host / is bind-mounted
# READ-WRITE at /host, recursively (rslave: host mounts propagate in; container
# mounts never leak back out). This is what lets the remote terminal, in-host,
# scripts, the NinjaOne file browser, AND Lockhart backups read and modify the
# entire host tree -- back up any host path as /host/<path>. On an ostree/atomic
# host /host/usr stays read-only because it is read-only on the host itself;
# everything the host root can write, the container can too.
Volume=/:/host:rw,rslave

# Host /proc pinned read-only at /host/proc for the in-host namespace handoff
# (/host/proc/1/ns/*). Explicit so the handoff never relies on the recursive
# propagation of the / bind above.
Volume=/proc:/host/proc:ro,rslave

# TrueNAS-native convenience: pools live under /mnt there, so exposing /mnt at the
# same path lets backup jobs target /mnt/<pool>/<dataset> exactly like a bare-metal
# agent (the same data is also reachable at /host/mnt on any host).
Volume=/mnt:/mnt:rw,rslave

# Report the HOST's OS to NinjaOne, not the container's Fedora. The agent reads
# /etc/os-release verbatim (that's where "Fedora Linux 42" comes from); mounting
# the host's over the container's makes the device show up as its real OS
# (Bazzite, TrueNAS SCALE, ...). Bound at /usr/lib/os-release because /etc/os-release
# is a symlink to it. dnf's $releasever is pinned in the image so this is safe.
Volume=/etc/os-release:/usr/lib/os-release:ro

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target default.target
