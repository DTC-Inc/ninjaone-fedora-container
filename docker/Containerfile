ARG FEDORA_VERSION=42
FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION}

LABEL org.opencontainers.image.source="https://github.com/DTC-Inc/ninjaone-fedora-container"
LABEL org.opencontainers.image.description="NinjaOne Linux agent as a systemd-init Fedora container: agent, patcher, and the Lockhart backup daemon run as native systemd services; host disk/ZFS/SMART introspection via host-namespace handoff."
LABEL org.opencontainers.image.licenses="MIT"
LABEL io.dtc.product="ninjaone-fedora-container"

# Toolset + systemd. systemd runs as PID 1 so the NinjaOne agent can install and
# supervise its own services exactly as on a normal host -- ninjarmm-agent, the
# patcher timer, and (the reason we need systemd at all) the Lockhart backup
# daemon com.ninjarmm.lockhartd.service, which has no other supervisor.
#
# We deliberately do NOT install the zfs userland here: its ioctl ABI is tied to
# the host kernel's OpenZFS version, which a Fedora package would not match. ZFS
# commands run the HOST's own binaries via the in-host wrapper instead.
RUN dnf -y install \
        systemd \
        bash-completion zsh tmux nano vim-enhanced less man-db \
        sudo which file findutils coreutils util-linux procps-ng psmisc \
        iproute iputils bind-utils net-tools traceroute mtr nmap-ncat \
        openssh-clients rsync wget curl ca-certificates openssl jq git \
        tar gzip bzip2 xz zstd unzip \
        htop lsof strace tcpdump \
        smartmontools lm_sensors pciutils usbutils hostname \
        python3 python3-pip \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# systemd-in-container hygiene: mask units that need real hardware or a console
# and would only fail/slow the boot. Also mask systemd-networkd + systemd-resolved:
# the container uses the host's network namespace (Network=host), so it must NOT
# run its own network manager or DNS resolver. A container-side resolved collides
# with the host's on 127.0.0.53 (shared loopback) and breaks name resolution --
# which kills the agent download and check-in. With no resolved running, the
# container's /etc/resolv.conf (podman points it at the host's) resolves via the
# host. The agent + backup services are unaffected.
RUN systemctl set-default multi-user.target \
    && systemctl mask \
        getty.target \
        console-getty.service \
        systemd-udevd.service \
        systemd-udev-trigger.service \
        systemd-remount-fs.service \
        dev-hugepages.mount \
        sys-fs-fuse-connections.mount \
        sys-kernel-config.mount \
        systemd-journald-audit.socket \
        systemd-networkd.service \
        systemd-networkd.socket \
        systemd-resolved.service

# Disable the kernel audit netlink for journald and dbus-broker. The host's
# auditd owns the single audit socket, so a container opening it fails with
# EUNATCH ("Protocol driver not attached", errno 49) -- which kills journald
# (no logs, system degraded) and dbus-broker (no D-Bus -> the agent's RPM
# post-install can't register ninjarmm-agent.service). Neither needs audit here.
RUN mkdir -p /etc/systemd/journald.conf.d /etc/systemd/system/dbus-broker.service.d \
    && printf '[Journal]\nAudit=no\n' \
        > /etc/systemd/journald.conf.d/10-no-audit.conf \
    && printf '[Service]\nExecStart=\nExecStart=/usr/bin/dbus-broker-launch --scope system\n' \
        > /etc/systemd/system/dbus-broker.service.d/10-no-audit.conf

# Lockhart (the LTDR backup daemon the agent installs at runtime) ships its own
# OpenSSL (nssl), which reads the system /etc/ssl/openssl.cnf at startup. Fedora's
# config pulls in crypto-policies options (e.g. rh-allow-sha1-signatures) that this
# OpenSSL build rejects as an "unknown option" -> the daemon dies on startup and
# never binds its gRPC port 50052, so backups never start (the agent logs
# "Failed to configure backup agent ... 127.0.0.1:50052: Connection refused").
# Point Lockhart's OpenSSL at an empty config via a drop-in on its unit; drop-ins
# match by unit name, so this applies whenever the agent lays the unit down.
RUN mkdir -p /etc/systemd/system/com.ninjarmm.lockhartd.service.d \
    && printf '[Service]\nEnvironment=OPENSSL_CONF=/dev/null\n' \
        > /etc/systemd/system/com.ninjarmm.lockhartd.service.d/10-openssl-conf.conf

# Pin dnf's $releasever to the container's own Fedora version. At runtime the
# deployment mounts the HOST's /etc/os-release over the container's (so NinjaOne
# reports the host OS -- Bazzite, TrueNAS SCALE -- instead of Fedora). But dnf
# also derives $releasever from os-release, so without this the first-boot agent
# install would try the host's version (e.g. a Debian release on TrueNAS) against
# Fedora repos and break. Pinning keeps dnf on the container's Fedora repos.
RUN mkdir -p /etc/dnf/vars \
    && . /etc/os-release && printf '%s\n' "$VERSION_ID" > /etc/dnf/vars/releasever

# First-boot bootstrap: downloads + installs the token-stamped agent RPM if the
# persistent /opt/NinjaRMMAgent volume is empty, then enables the agent service.
COPY ninjarmm-bootstrap.sh /usr/local/bin/ninjarmm-bootstrap.sh
COPY ninjarmm-bootstrap.service /etc/systemd/system/ninjarmm-bootstrap.service

# Host-namespace handoff: in-host runs a command inside the host's namespaces
# (via the bind-mounted host /proc), so the host's own tools answer. zpool/zfs
# are symlinks to it -> NinjaOne scripts and the remote terminal get real,
# version-matched ZFS against the host pools without installing zfs in here.
COPY in-host /usr/local/bin/in-host

# Optional baked agent. CI stages a zero-byte placeholder, so `|| true` keeps the
# build green; real deployments download at first boot via NINJA_AGENT_URL.
COPY agent.rpm /tmp/agent.rpm

RUN chmod 0755 /usr/local/bin/ninjarmm-bootstrap.sh /usr/local/bin/in-host \
    && ln -sf in-host /usr/local/bin/zpool \
    && ln -sf in-host /usr/local/bin/zfs \
    && systemctl enable ninjarmm-bootstrap.service \
    && mkdir -p /opt/NinjaRMMAgent

# `|| true`: a zero-byte placeholder (CI) or a vendor %post that assumes a booted
# host can return nonzero; the agent still installs cleanly on first real boot.
RUN dnf -y install /tmp/agent.rpm || true; rm -f /tmp/agent.rpm

# systemd's clean-shutdown signal.
STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/usr/sbin/init"]
