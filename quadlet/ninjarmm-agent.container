[Unit]
Description=NinjaOne Agent (containerized)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/dtc-inc/ninjaone-fedora-container:latest
ContainerName=ninjarmm-agent
HostName=%H
Network=host

PodmanArgs=--pid=host --ipc=host --privileged

# NINJA_AGENT_URL: public download link for the token-stamped NinjaOne Linux
# agent RPM. The entrypoint downloads + installs it on first run, only if no
# agent is already in the ninjarmm-state volume. Keep the (token-bearing) URL
# out of git by setting it in /etc/ninjarmm-agent.env; the `-` prefix makes the
# file optional, so a baked-in-RPM image works with no env file present.
# scripts/install.sh writes this file for you when NINJA_AGENT_URL is exported.
EnvironmentFile=-/etc/ninjarmm-agent.env
Environment=PATCHER_INTERVAL=300

Volume=ninjarmm-state:/state

Volume=/sys:/sys:ro
Volume=/dev:/dev

Volume=/:/host:ro,rslave
Volume=/etc:/host/etc:rw,rslave
Volume=/var:/host/var:rw,rslave
Volume=/home:/host/home:rw,rslave

[Service]
Restart=always
TimeoutStartSec=300
ExecStopPost=-/bin/umount /opt/NinjaRMMAgent

[Install]
WantedBy=multi-user.target default.target
